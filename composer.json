{
  "name": "wexample/symfony-signature-demo",
  "description": "Demo of symfony-signature: a sample envelope sent from the demo account to another and to someone outside, signed, verified, its proof downloaded",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonySignatureDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-loader": ">=22.0.0",
    "wexample/symfony-design-system": ">=32.0.0",
    "wexample/symfony-media": ">=1.0.1",
    "wexample/symfony-signature": ">=1.0.1",
    "wexample/symfony-signature-ds": ">=1.0.1",
    "wexample/symfony-user-demo": ">=1.0.1"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
